      "Bash(screencapture -x -R2280,0,420,360 /tmp/menu-open.png)",
      "Bash(sips -g pixelWidth -g pixelHeight /tmp/menu-open.png)",
      "Bash(OMI_AUTOMATION_PORT=47780 ./scripts/omi-ctl --bundle com.omi.omi-togglefix actions)",
      "Bash(./scripts/omi-ctl actions *)",
      "Bash(./scripts/omi-ctl wait-ready *)",
      "Bash(awk '{print $2, $11, $12, $13}')",
